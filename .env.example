# =============================================================================
# OutReachIQ — Environment Configuration Template
# =============================================================================
# Copy this file to `backend/.env` for local configuration.
# NEVER commit the actual `backend/.env` file or any real secrets to version control.
# In production (ENVIRONMENT=production), secure non-default secrets are strictly enforced.

# -----------------------------------------------------------------------------
# 1. Application Environment & Core Server
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development
PROJECT_NAME=OutReachIQ
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# -----------------------------------------------------------------------------
# 2. Database Configuration
# -----------------------------------------------------------------------------
# Default: Local SQLite for zero-dependency development
DATABASE_URL=sqlite:///./outreachiq.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/outreachiq

# -----------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# -----------------------------------------------------------------------------
# In development, the default dev placeholder may be used.
# In production (ENVIRONMENT=production), a unique secret of >= 32 characters IS REQUIRED.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=outreachiq_dev_secret_key_change_in_production_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# 4. Token Encryption (OAuth Tokens at Rest)
# -----------------------------------------------------------------------------
# Used to encrypt OAuth tokens stored in the database.
# In production (ENVIRONMENT=production), a unique key of >= 32 characters IS REQUIRED.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=outreachiq_default_dev_encryption_key_2026_xyz

# -----------------------------------------------------------------------------
# 5. Generative AI / LLM Outreach Providers
# -----------------------------------------------------------------------------
# Active provider selector: openrouter, openai, or gemini
# If all keys are empty, OutReachIQ safely falls back to a deterministic template generator.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 6. Primary Search & Opportunity Discovery Providers (Tier 1)
# -----------------------------------------------------------------------------
# Tavily powers live opportunity web search and company headcount research (~1,000 requests/mo free tier).
# Exa powers neural / semantic company and job discovery (~1,000 requests/mo / $10 credit free tier).
# Keys server-side only: https://tavily.com and https://exa.ai
TAVILY_API_KEY=
EXA_API_KEY=

# -----------------------------------------------------------------------------
# 7. Secondary Job Board Discovery Providers (Tier 2 / Free Fallback)
# -----------------------------------------------------------------------------
# Remotive Public Feed requires NO API key and is permanently enabled as a zero-cost fallback.
# Secondary providers are queried ONLY if Tier 1 fails, rate limits, or yields < DISCOVERY_MIN_RELEVANT_RESULTS (5).
# Adzuna Jobs (Free developer portal tier): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble Jobs (Free partner plan): https://jooble.org/api/about
JOOBLE_API_KEY=
# RapidAPI JSearch (Free tier ~50 req/mo - hard daily cap enforced to avoid overages):
JSEARCH_API_KEY=
# SerpApi Google Jobs (Free plan ~100 req/mo - hard daily cap enforced):
SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# 7b. Two-Tier Discovery Architecture & Local Free-Tier Safety Caps
# -----------------------------------------------------------------------------
# Tier provider ordering & fallback quality gate
DISCOVERY_MIN_RELEVANT_RESULTS=5
DISCOVERY_RATE_LIMIT_COOLDOWN_SECONDS=60
# Local daily quota caps (strictly enforced in-memory to prevent unexpected provider charges)
DISCOVERY_DAILY_QUOTA_TAVILY=50
DISCOVERY_DAILY_QUOTA_EXA=50
DISCOVERY_DAILY_QUOTA_REMOTIVE=100
DISCOVERY_DAILY_QUOTA_ADZUNA=100
DISCOVERY_DAILY_QUOTA_JOOBLE=100
DISCOVERY_DAILY_QUOTA_JSEARCH=10
DISCOVERY_DAILY_QUOTA_SERPAPI=10

# -----------------------------------------------------------------------------
# 8. Google OAuth & Gmail Integration
# -----------------------------------------------------------------------------
# Configure via Google Cloud Console with Gmail API enabled:
# Redirect URI must match: http://localhost:4200/outreach
# If omitted, OutReachIQ uses an offline mock client simulator for testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/outreach

# Dispatch Safety Limits
OUTREACH_DEFAULT_DAILY_LIMIT=15
OUTREACH_DEFAULT_COOLDOWN_MINUTES=15
OUTREACH_DUPLICATE_SUPPRESSION_DAYS=30

# -----------------------------------------------------------------------------
# 9. Local Uploads Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# 10. Educational & Video Learning Providers (Phase 3 - Optional)
# -----------------------------------------------------------------------------
# YouTube Data API v3 (free 10,000 units/day default allowance; search = 100 units)
# If omitted, OutReachIQ safely displays curated official video tutorials with 0 API calls.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=25
